<!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath> -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoMapper 13.0.1 is vulnerable (GHSA-rvv3-g6hj-g44x). The fix ships in 15.1.1+,
         which carries a new RPL-1.5/commercial dual license (Lucky Penny Software) and is
         out of scope for this .NET 8->10 platform upgrade. Suppressing this advisory only;
         the AutoMapper major-version/licensing decision needs a separate team discussion. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
    <!-- SSH.NET 2023.0.0 (transitive via Testcontainers.MsSql, test-only) is vulnerable.
         Fixing requires a Testcontainers 3.x -> 4.x major bump, out of scope for this
         platform upgrade. Suppressing these advisories; follow-up ticket should upgrade
         Testcontainers.MsSql. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-mggc-4xg6-vcxf" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
  </ItemGroup>
</Project>